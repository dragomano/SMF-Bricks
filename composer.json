{
  "name": "bugo/smf-bricks",
  "description": "Collection of some building blocks for SMF",
  "type": "library",
  "keywords": [
    "smf",
    "helpers",
    "tables",
    "forms",
    "presenters",
    "settings",
    "breadcrumbs"
  ],
  "homepage": "https://github.com/dragomano/SMF-Bricks",
  "license": "MIT",
  "authors": [
    {
      "name": "Bugo",
      "email": "bugo@dragomano.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Bugo\\Bricks\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "nette/utils": "^4.0"
  },
  "require-dev": {
    "infection/infection": "^0.31",
    "mockery/mockery": "^1.6.15",
    "pestphp/pest": "^3|^4|^5",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.6"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --no-progress",
    "analyse-baseline": "vendor/bin/phpstan analyse --no-progress --generate-baseline",
    "check": "vendor/bin/rector process --dry-run --clear-cache",
    "test": "vendor/bin/pest --colors=always",
    "test-coverage": "vendor/bin/pest --colors=always --coverage --min=100",
    "test-coverage-clover": "vendor/bin/pest --colors=always --min=100 --coverage-clover coverage.xml",
    "test-coverage-html": "vendor/bin/pest --colors=always --min=100 --coverage-html coverage",
    "test-mutate": "@php vendor/bin/infection --threads=4 --show-mutations=20 --no-interaction"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "infection/extension-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
