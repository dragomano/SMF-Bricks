includes:
	- vendor/phpstan/phpstan-strict-rules/rules.neon
	- phpstan-baseline.neon

parameters:
	level: 9
	paths:
		- src
	tmpDir: .phpstan.cache
	# The library validates input at runtime, so PHPDoc types are treated as hints,
	# not as guarantees (otherwise defensive checks look like dead code).
	treatPhpDocTypesAsCertain: false
